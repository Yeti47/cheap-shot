# cheap-shot bridge configuration — copy to .env and fill in your values.
# These are per-unit device values from the factory record
# (firmware/logical/factory_config.json). Keep .env local; it is gitignored.

# Dashboard / HTTP bind address. 127.0.0.1 = reachable from the host only;
# use 0.0.0.0:8080 to expose it on the LAN.
CHEAPSHOT_LISTEN=127.0.0.1:8080

# Camera "cam1" (the suffix CAM1 matches the camera name):
CHEAPSHOT_CAM1_HOST=192.168.9.252
CHEAPSHOT_CAM1_DID=PP00A9XXXXXXXXXX
CHEAPSHOT_CAM1_LSLAT=AAAA000000000000000000==

# Optional: expose as a /dev/video* webcam (load v4l2loopback on the host and
# uncomment the devices:/group_add: lines in compose.yaml first).
#CHEAPSHOT_CAM1_V4L2_DEVICE=/dev/video10
